@model HTML_Helpers_Project.Models.Students
@{
    ViewBag.Title = "Templated_Helper_Ind";
}

<h2>Templated_Helper_Ind</h2>

@using (Html.BeginForm())
            {
                <table>
                    <tr>
                        <td>@Html.DisplayName("Roll Number")</td>
                        <td>@Html.Editor("rno")</td>
                    </tr>
                    <tr>
                        <!-- strongly typed tag -->
                        <td>@Html.DisplayNameFor(m => m.RNO)</td>
                        <td>@Html.EditorFor(m => m.RNO)</td>
                    </tr>
                    <tr>
                        <td>@Html.DisplayName("Student name")</td>
                        <td>@Html.Editor("name")</td>
                    </tr>
                    <tr>
                        <td>@Html.DisplayName("Address")</td>
                        <td>@Html.Editor("address")</td>
                    </tr>
                </table>
            }